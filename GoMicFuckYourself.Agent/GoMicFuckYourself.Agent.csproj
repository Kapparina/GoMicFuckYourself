<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <AssemblyName>GoMicFuckYourself.Agent</AssemblyName>
        <RootNamespace>GoMicFuckYourself.Agent</RootNamespace>
        <AssemblyTitle>GoMicFuckYourself Agent</AssemblyTitle>
        <Description>Per-user background agent that enforces the configured microphone and input volume policy.</Description>
